{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unit-test-runner.local/schemas/review_record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "subject", "data"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "review_record"},
    "subject": {"$ref": "common.schema.json#/$defs/subject"},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "artifact_sha256",
        "decision",
        "reviewer",
        "reviewed_at",
        "comment"
      ],
      "properties": {
        "artifact_kind": {
          "enum": [
            "function_dossier",
            "test_spec",
            "build_probe_report",
            "reanalysis_report"
          ]
        },
        "artifact_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "decision": {"enum": ["approved", "changes_requested"]},
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        },
        "comment": {"type": "string"}
      }
    }
  }
}
