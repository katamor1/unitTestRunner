{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unit-test-runner.local/schemas/test_spec.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "subject", "data"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "test_spec"},
    "subject": {"$ref": "common.schema.json#/$defs/subject"},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_id", "revision", "source", "function", "generated_from",
        "generation_policy", "test_cases", "additional_case_candidates",
        "coverage_summary", "unresolved_items", "warnings", "review_item_ids"
      ],
      "properties": {
        "spec_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "source": {"type": "object"},
        "function": {"type": "object"},
        "generated_from": {"type": "array", "items": {"type": "object"}},
        "generation_policy": {"type": "object"},
        "test_cases": {"type": "array", "items": {"type": "object"}},
        "additional_case_candidates": {"type": "array", "items": {"type": "object"}},
        "coverage_summary": {"type": "object"},
        "unresolved_items": {"type": "array", "items": {"type": "object"}},
        "warnings": {"type": "array", "items": {"type": "object"}},
        "review_item_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}
