{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unit-test-runner.local/schemas/common.schema.json",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "source_sha256",
        "function",
        "project",
        "configuration"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "function": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
