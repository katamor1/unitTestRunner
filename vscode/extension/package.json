{
  "name": "unit-test-runner-vscode",
  "displayName": "Unit Test Runner",
  "description": "UnitTestRunner v0.1 CLIをVS Codeから操作する薄いアダプターです。",
  "version": "0.1.0",
  "publisher": "local",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/katamor1/unitTestRunner.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onView:unitTestRunner.workflow",
    "onView:unitTestRunner.suite",
    "onCommand:unitTestRunner.analyzeCurrentFunction",
    "onCommand:unitTestRunner.analyzeSelectedFunction",
    "onCommand:unitTestRunner.reanalyzeCurrentFunction",
    "onCommand:unitTestRunner.finalizeDossier",
    "onCommand:unitTestRunner.openFunctionDossier",
    "onCommand:unitTestRunner.openReviewChecklist",
    "onCommand:unitTestRunner.openTestInputEditor",
    "onCommand:unitTestRunner.prepareHarness",
    "onCommand:unitTestRunner.buildProbeDryRun",
    "onCommand:unitTestRunner.runBuildProbe",
    "onCommand:unitTestRunner.runTests",
    "onCommand:unitTestRunner.registerCurrentFunctionInSuite",
    "onCommand:unitTestRunner.runSelectedSuiteTests",
    "onCommand:unitTestRunner.openSuiteRunReport",
    "onCommand:unitTestRunner.openOutputWorkspace",
    "onCommand:unitTestRunner.copyLastCommand"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "unitTestRunner.analyzeCurrentFunction", "title": "UnitTestRunner: 現在の関数を解析" },
      { "command": "unitTestRunner.analyzeSelectedFunction", "title": "UnitTestRunner: 選択した関数を解析" },
      { "command": "unitTestRunner.reanalyzeCurrentFunction", "title": "UnitTestRunner: 現在の関数を再解析" },
      { "command": "unitTestRunner.finalizeDossier", "title": "UnitTestRunner: dossierを確定" },
      { "command": "unitTestRunner.openFunctionDossier", "title": "UnitTestRunner: function dossierを開く" },
      { "command": "unitTestRunner.openReviewChecklist", "title": "UnitTestRunner: レビュー確認リストを開く" },
      { "command": "unitTestRunner.openTestInputEditor", "title": "UnitTestRunner: TestSpecをレビュー" },
      { "command": "unitTestRunner.prepareHarness", "title": "UnitTestRunner: ハーネスを準備" },
      { "command": "unitTestRunner.buildProbeDryRun", "title": "UnitTestRunner: ビルドの事前確認" },
      { "command": "unitTestRunner.runBuildProbe", "title": "UnitTestRunner: ビルドを実行" },
      { "command": "unitTestRunner.runTests", "title": "UnitTestRunner: テストを実行" },
      { "command": "unitTestRunner.registerCurrentFunctionInSuite", "title": "UnitTestRunner: 現在の関数をスイートに登録" },
      { "command": "unitTestRunner.runSelectedSuiteTests", "title": "UnitTestRunner: 選択したスイート項目を実行" },
      { "command": "unitTestRunner.openSuiteRunReport", "title": "UnitTestRunner: スイート実行レポートを開く" },
      { "command": "unitTestRunner.openOutputWorkspace", "title": "UnitTestRunner: 出力ワークスペースを開く" },
      { "command": "unitTestRunner.copyLastCommand", "title": "UnitTestRunner: 最後のCLIコマンドをコピー" }
    ],
    "menus": {
      "editor/context": [
        { "command": "unitTestRunner.analyzeCurrentFunction", "when": "editorLangId == c", "group": "navigation@10" },
        { "command": "unitTestRunner.analyzeSelectedFunction", "when": "editorHasSelection && editorLangId == c", "group": "navigation@11" }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        { "id": "unitTestRunner", "title": "Unit Test Runner", "icon": "media/unit-test-runner.svg" }
      ]
    },
    "views": {
      "unitTestRunner": [
        { "id": "unitTestRunner.workflow", "name": "関数テスト", "type": "webview" },
        { "id": "unitTestRunner.suite", "name": "テストスイート", "type": "webview" }
      ]
    },
    "configuration": {
      "title": "Unit Test Runner",
      "properties": {
        "unitTestRunner.cliPath": {
          "type": "string", "default": "unit-test-runner", "scope": "resource",
          "description": "UnitTestRunner CLIまたは実行ファイルのパスです。既定値では同梱Windows x64 CLIを優先します。"
        },
        "unitTestRunner.sourceRoot": {
          "type": "string", "default": "", "scope": "resource",
          "description": "対象sourceのルートです。未設定時はactive documentを含むworkspace folderを使用します。"
        },
        "unitTestRunner.dswPath": {
          "type": "string", "default": "", "scope": "resource",
          "description": "対象Visual C++ 6.0 workspace（.dsw）のパスです。"
        },
        "unitTestRunner.outputRoot": {
          "type": "string", "default": "", "scope": "resource",
          "description": "source root外の成果物出力先です。"
        },
        "unitTestRunner.suiteManifestPath": {
          "type": "string", "default": "", "scope": "resource",
          "description": "portable suite manifestのパスです。未設定時はoutputRoot/suites/default/suite_manifest.jsonを使用します。"
        },
        "unitTestRunner.defaultConfiguration": {
          "type": "string", "default": "Win32 Debug", "scope": "resource",
          "description": "既定のVC6 configurationです。"
        },
        "unitTestRunner.defaultProject": {
          "type": "string", "default": "", "scope": "resource",
          "description": "source membershipが複数候補の場合に使う明示projectです。"
        },
        "unitTestRunner.vcvarsPath": {
          "type": "string", "default": "", "scope": "resource",
          "description": "VC6 build環境を設定するbat/cmdのパスです。"
        },
        "unitTestRunner.autoOpenDossier": {
          "type": "boolean", "default": true, "scope": "resource",
          "description": "dossier確定成功後にfunction_dossier.mdを開きます。"
        },
        "unitTestRunner.runBuildProbeRequiresConfirmation": {
          "type": "boolean", "default": true, "scope": "resource",
          "description": "実ビルド前に確認ダイアログを表示します。"
        },
        "unitTestRunner.runTestsRequiresConfirmation": {
          "type": "boolean", "default": true, "scope": "resource",
          "description": "実テスト前に確認ダイアログを表示します。"
        },
        "unitTestRunner.commandTimeoutSeconds": {
          "type": "number", "default": 300, "minimum": 1, "scope": "resource",
          "description": "CLI process treeを終了するまでのtimeout秒数です。"
        }
      }
    }
  },
  "scripts": {
    "compile": "node ./scripts/clean-dist.cjs && tsc -p ./",
    "test": "npm run compile && node ./scripts/run-unit-tests.cjs",
    "test:extension-host": "npm run compile && node ./dist/test/runTest.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.0.0",
    "typescript": "^5.4.5"
  }
}
